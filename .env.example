# Copy this file to .env and fill it in. src/llm.py reads these; .env is gitignored.
# Any OpenAI-compatible endpoint works. Keep one model for every demo run so outputs are comparable.

# Nous Portal (team default). The shared key is in the team Slack DM; never commit it.
LLM_BASE_URL=https://inference-api.nousresearch.com/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
# LLM_MODEL=deepseek/deepseek-v4-flash-0731   # fallback, same family, cheaper
# z-ai/glm-5.3-flash was tested 2026-09-20 and is NOT a drop-in: this gateway makes its reasoning
# mandatory (the off-switch in src/llm.py returns 400) and it wraps JSON replies in an extra key.
LLM_API_KEY=sk-nous-paste-the-shared-key-here

# Nous Portal mirrors the OpenRouter catalog, so model ids are OpenRouter's.

# Local server example (llama.cpp, llama-swap, Ollama's OpenAI endpoint)
# LLM_BASE_URL=http://127.0.0.1:9090/v1
# LLM_MODEL=Qwen3.6-27B
# LLM_API_KEY=local

# Seconds before a single call is abandoned (default 60)
# LLM_TIMEOUT=60
